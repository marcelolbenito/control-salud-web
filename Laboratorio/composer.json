{
    "name": "clinica/laboratorio",
    "description": "Modulo de gestion de laboratorio clinico - integrable con sistema clinico mayor (Fase 1 MVP).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "dompdf/dompdf": "^3.0",
        "monolog/monolog": "^3.7",
        "phpoffice/phpspreadsheet": "^5.7",
        "smalot/pdfparser": "^2.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
